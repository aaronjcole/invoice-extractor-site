{
  "name": "ScanLog",
  "type": "object",
  "properties": {
    "file_name": {
      "type": "string"
    }
  },
  "required": [
    "file_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}