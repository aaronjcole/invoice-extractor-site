{
  "name": "Entitlement",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "lifetime",
        "day_pass"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_session_id": {
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}